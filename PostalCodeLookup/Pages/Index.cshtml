@page
@model IndexModel
@{
    ViewData["Title"] = "Postal Code Lookup";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="text-center mb-4">Postal Code Address Lookup</h1>
            <p class="text-center text-muted mb-4">Enter a postal code to see all available addresses</p>
            
            <div class="card shadow">
                <div class="card-body">
                    <div class="mb-3">
                        <label for="postalCodeInput" class="form-label">Postal Code</label>
                        <input type="text" 
                               class="form-control form-control-lg" 
                               id="postalCodeInput" 
                               placeholder="e.g., 10001, 90210, 60601, 98101"
                               autocomplete="off">
                        <div class="form-text">Try: 10001, 90210, 60601, or 98101</div>
                    </div>
                    
                    <div id="addressList" class="list-group" style="display: none;">
                        <!-- Addresses will be populated here -->
                    </div>
                    
                    <div id="noResults" class="alert alert-info mt-3" style="display: none;">
                        No addresses found for this postal code.
                    </div>
                    
                    <div id="loading" class="text-center mt-3" style="display: none;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const postalCodeInput = document.getElementById('postalCodeInput');
            const addressList = document.getElementById('addressList');
            const noResults = document.getElementById('noResults');
            const loading = document.getElementById('loading');
            let debounceTimer;

            postalCodeInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const postalCode = this.value.trim();

                if (postalCode.length === 0) {
                    hideAll();
                    return;
                }

                // Debounce the API call
                debounceTimer = setTimeout(function() {
                    searchAddresses(postalCode);
                }, 300);
            });

            function hideAll() {
                addressList.style.display = 'none';
                noResults.style.display = 'none';
                loading.style.display = 'none';
                addressList.innerHTML = '';
            }

            async function searchAddresses(postalCode) {
                hideAll();
                loading.style.display = 'block';

                try {
                    const response = await fetch(`?handler=SearchAddresses&postalCode=${encodeURIComponent(postalCode)}`);
                    const addresses = await response.json();

                    loading.style.display = 'none';

                    if (addresses && addresses.length > 0) {
                        addressList.innerHTML = '';
                        addresses.forEach(function(address) {
                            const item = document.createElement('div');
                            item.className = 'list-group-item list-group-item-action';
                            item.innerHTML = `
                                <div class="d-flex w-100 justify-content-between">
                                    <p class="mb-0">${escapeHtml(address)}</p>
                                </div>
                            `;
                            addressList.appendChild(item);
                        });
                        addressList.style.display = 'block';
                    } else {
                        noResults.style.display = 'block';
                    }
                } catch (error) {
                    loading.style.display = 'none';
                    console.error('Error fetching addresses:', error);
                    alert('An error occurred while fetching addresses. Please try again.');
                }
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        });
    </script>
}
